# ============================================================
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Banco de dados
POSTGRES_PASSWORD=troque-esta-senha

# API Key para proteger os endpoints (gere uma string aleatória)
API_KEY=troque-esta-api-key

# ---- Meta Ads ------------------------------------------------
# Crie um App em developers.facebook.com e gere um token de longa duração
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ---- Google Ads ----------------------------------------------
# Solicite Developer Token em: ads.google.com → Ferramentas → API Center
# Crie credenciais OAuth2 Desktop App no GCP projeto dashboard-491401
# Rode o script scripts/generate_google_refresh_token.py para obter o refresh token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # ID do Manager Account (MCC), sem hifens

# ---- GA4 (Fase 7 — preencher quando tiver acesso) -----------
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/dashboard-491401-c0437eaebae8.json

# ---- App ----
BACKEND_URL=http://localhost:8000
DASH_DEBUG=false
